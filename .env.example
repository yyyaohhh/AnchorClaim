# LLM provider (also configurable from the in-app Settings page, which writes
# .anchorclaim_settings.json). Presets: openai | claude | custom.
#ANCHORCLAIM_PROVIDER=openai
#ANCHORCLAIM_API_KEY=

# On-chain settlement config (leave blank to run in mock mode)
RPC_URL=https://sepolia.base.org
ESCROW_ADDR=0xYourDeployedEscrow
ATTESTOR_KEY=0xYourTestnetPrivateKey

# Multi-agent evidence reasoning (leave blank to run the deterministic fallback).
# Each configured agent votes independently; a claim needs a strict majority of the
# agents that respond to be corroborated. No SDK required — plain HTTPS calls.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
